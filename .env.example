# Copy to .env (not committed). Vite exposes only VITE_* to the browser.
VITE_GEMINI_API_KEY=
GEMINI_API_KEY=

# --- Postgres (primary auth & API) ---
# Local: docker compose up -d  →  Postgres 16 + Mailpit
DATABASE_URL=postgres://smriti:smriti@127.0.0.1:5432/smriti
API_PORT=8787

# Vercel / production (Project Settings → Environment Variables):
#   DATABASE_URL=postgres://…   (Neon, Supabase, or Vercel Postgres)
# Aliases also work: POSTGRES_URL, POSTGRES_PRISMA_URL, DATABASE_URL_UNPOOLED
# After setting the URL, migrate once from your machine (no local Docker required):
#   DATABASE_URL='postgres://…' npm run db:migrate
# Optional seed: DATABASE_URL='postgres://…' npm run db:seed

# Optional Supabase overlay (does NOT replace Postgres auth).
# Set locally in .env.local (gitignored). Same names in Vercel.
# Vite app: VITE_* is enough. NEXT_PUBLIC_* also works (vite envPrefix).
# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# VITE_SUPABASE_ANON_KEY=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional later: VITE_API_ORIGIN=https://YOUR-RENDER-SERVICE.onrender.com
# CORS_ORIGIN=https://YOUR-VERCEL-APP.vercel.app


# OTP is emailed (not SMS). Local: Mailpit UI http://127.0.0.1:8025
# Real inbox / Vercel: set SMTP_EMAIL + SMTP_APP_PASSWORD (Gmail app password).
MAILPIT_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL=
SMTP_APP_PASSWORD=
AUTH_DEV_MODE=false

# Google Sign-In (optional, not wired yet):
# 1. https://console.cloud.google.com/apis/credentials
# 2. Create OAuth client → Web application
# 3. Authorized JS origins: http://localhost:5173 and your live site
# 4. Authorized redirect URIs: http://localhost:5173/signin and https://YOUR-SITE/signin
# 5. Put the client id here, then we can add a "Continue with Google" button.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
