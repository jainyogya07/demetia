# Copy to .env (not committed). Vite exposes only VITE_* to the browser.
VITE_GEMINI_API_KEY=
GEMINI_API_KEY=

# Postgres — used by scripts/db.mjs and server/api.mjs
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/saheli
API_PORT=8787

# FastAPI email OTP (backend/main.py) — never hardcode Gmail passwords
SMTP_EMAIL=
SMTP_APP_PASSWORD=
# true = show OTP in API (local). Phone OTP is stored in Postgres app_users / otp_challenges.
AUTH_DEV_MODE=true
