# Copy to .env (not committed). Vite exposes only VITE_* to the browser.
VITE_GEMINI_API_KEY=
GEMINI_API_KEY=

# Open-source stack: docker compose up -d
# Postgres 16 (official image) + Mailpit (https://github.com/axllent/mailpit)
DATABASE_URL=postgres://smriti:smriti@127.0.0.1:5432/smriti
API_PORT=8787

# OTP is emailed (not SMS). Local: Mailpit UI http://127.0.0.1:8025
# Real inbox later: set SMTP_EMAIL + SMTP_APP_PASSWORD (Gmail app password).
# Correlated auth (patient + caregiver + doctor): npm run auth  →  /auth-api
MAILPIT_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL=
SMTP_APP_PASSWORD=
AUTH_DEV_MODE=false

# WhatsApp OTP via Meta (WhatsApp Business Cloud API)
# Get from Meta Developer Portal -> WhatsApp -> API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=auth_otp_code
WHATSAPP_TEMPLATE_LANG=en_US
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# Google Sign-In (optional, not wired yet):
# 1. https://console.cloud.google.com/apis/credentials
# 2. Create OAuth client → Web application
# 3. Authorized JS origins: http://localhost:5173 and your live site
# 4. Authorized redirect URIs: http://localhost:5173/signin and https://YOUR-SITE/signin
# 5. Put the client id here, then we can add a "Continue with Google" button.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Firebase Phone Auth (10,000 free SMS OTPs/month to ANY phone number)
# Get from console.firebase.google.com -> Project Settings -> General -> Your apps (Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

