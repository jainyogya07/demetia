# Isolated keypad SMS/USSD service. Do not put these in the main app .env.

# Optional Twilio (leave blank for local curl /sim testing)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# uvicorn keypad-sms.app:app --app-dir keypad-sms --port 8010
# Feature phone page: http://127.0.0.1:8010/  or  http://localhost:5173/keypad.html
# GET SMS (no POST needed): http://127.0.0.1:8010/sms/inbound?From=9810112345&Body=1
# Twilio webhook: https://YOUR-HOST/sms/inbound
# USSD webhook:   https://YOUR-HOST/ussd/inbound
