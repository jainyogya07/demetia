# FastAPI email OTP (never put the Gmail app password in source)
SMTP_EMAIL=
SMTP_APP_PASSWORD=
# Optional aliases used by older Amongus notes:
# EMAIL=
# APP_PASSWORD=
# Local demo without SMTP — OTP is printed and returned in JSON
AUTH_DEV_MODE=false

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=auth_otp_code
WHATSAPP_TEMPLATE_LANG=en_US
WHATSAPP_DEFAULT_COUNTRY_CODE=91
