# Copy to .env (not committed). Vite exposes only VITE_* to the browser.
VITE_GEMINI_API_KEY=
GEMINI_API_KEY=

# Postgres — used by scripts/db.mjs and server/api.mjs
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/saheli
API_PORT=8787

# OTP: open-source Mailpit by default (npm run mailpit → http://127.0.0.1:8025).
# Optional real inbox: set SMTP_EMAIL + SMTP_APP_PASSWORD (Gmail app password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL=
SMTP_APP_PASSWORD=
AUTH_DEV_MODE=true
